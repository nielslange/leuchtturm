{
	"name": "leuchtturm",
	"description": "",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"WordPress",
		"Theme",
		"Leuchtturm"
	],
	"homepage": "https://github.com/nielslange/leuchtturm#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nielslange/leuchtturm.git"
	},
	"bugs": {
		"url": "https://github.com/nielslange/leuchtturm/issues"
	},
	"devDependencies": {
		"@wordpress/env": "10.17.0",
		"@wordpress/prettier-config": "4.17.0",
		"@wordpress/stylelint-config": "^23.9.0",
		"browser-sync": "3.0.3",
		"eslint": "9.19.0",
		"glightbox": "3.3.1",
		"nord": "0.2.1",
		"normalize-scss": "8.0.0",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.5.1",
		"postcss-scss": "^4.0.9",
		"prettier": "npm:wp-prettier@3.0.3",
		"sass": "1.83.4",
		"sass-migrator": "^2.3.1",
		"stylelint": "16.14.1",
		"stylelint-config-default": "0.2.0",
		"stylelint-config-recommended": "15.0.0",
		"stylelint-config-recommended-scss": "14.1.0",
		"stylelint-prettier": "5.0.3",
		"stylelint-scss": "6.11.0"
	},
	"scripts": {
		"build": "sass --style=compressed --load-path=node_modules/normalize-scss/sass/ assets/scss:.",
		"build:glightbox": "cp node_modules/glightbox/dist/js/glightbox.min.js assets/js/ && cp node_modules/glightbox/dist/css/glightbox.min.css assets/css",
		"build:zip": "pnpm build && bash ./bin/bundle.sh",
		"phpcbf": "composer run phpcbf",
		"phpcs": "composer run phpcs",
		"phplint": "composer run phplint",
		"stylelint": "stylelint 'assets/scss/**/*.scss'",
		"sync": "browser-sync start --proxy 'https://easternpromise.test/'",
		"test": "run-s phpcs phplint",
		"watch": "npm run build && npm run build -- --watch",
		"wp-env": "wp-env"
	}
}
